{
  "expo": {
    "name": "AI Diary",
    "slug": "ai-sanctuary",
    "version": "1.9.6",
    "scheme": "sanctuary",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.christeck.aidiary",
      "versionCode": 33,
      "launchMode": "singleTask",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_adaptive_foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.christeck.aidiary",
      "buildNumber": "37",
      "appleTeamId": "5BSRSHBRR6",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "AI Diary necesita acceso al micrófono para que puedas hablar con la IA en modo Walkie-Talkie.",
        "NSCameraUsageDescription": "AI Diary necesita la cámara para que puedas enviarle fotos a la IA y analizarlas.",
        "NSPhotoLibraryUsageDescription": "AI Diary necesita acceso a tus fotos para que puedas seleccionar imágenes para análisis visual."
      }
    },
    "extra": {
      "eas": {
        "projectId": "85232bcf-6feb-4642-aeab-e7272a16f836"
      }
    },
    "owner": "christeck-services",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "./plugins/withIosCxxStandard",
      "./plugins/withIosEntitlements",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#050505"
          }
        }
      ]
    ]
  }
}