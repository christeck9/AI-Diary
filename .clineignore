*.bin
*.onnx
*.model
*.tflite
*.weights

# Multimedia (Prevent AI from trying to "read" binary data)
*.zip
*.tar.gz
*.rar
*.7z
*.mp3
*.wav
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.gif
*.svg
sonido.zip

