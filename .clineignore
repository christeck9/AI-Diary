android/build/
# android/.gradle/
android/.cxx/
ios/build/


# iOS
ios/
ios/build/
ios/Pods/
ios/.symlinks/
*.ipa
*.app
*.xcarchive


# Expo specific
.expo/
dist/
web-build/
*.jks
*.keystore

# Machine Learning & Large Binaries (Crucial for VRAM/Context protection)
