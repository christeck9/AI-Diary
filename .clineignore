# --- CLIN-SPECIFIC IGNORE (Optimized for AI Sanctuary) ---

# Dependency directories
node_modules/
bun.lockb
package-lock.json
yarn.lock

# Native Build Artifacts (Heavy & irrelevant for logic audits)
android/
ios/
bin/
obj/
*.apk
*.ipa
*.app
