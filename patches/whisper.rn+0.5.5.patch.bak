diff --git a/node_modules/whisper.rn/android/.cxx/Debug/44v3g3w6/arm64-v8a/CMakeFiles/3.22.1-g37088a8-dirty/CompilerIdCXX/CMakeCXXCompilerId.cpp b/node_modules/whisper.rn/android/.cxx/Debug/44v3g3w6/arm64-v8a/CMakeFiles/3.22.1-g37088a8-dirty/CompilerIdCXX/CMakeCXXCompilerId.cpp
