# EAS Build ignore file
# Prevents uploading heavy or unnecessary files to the Expo build servers

# Dependency directories
node_modules/

# Local builds and caches (extremely heavy)
**/.gradle/
**/build/
**/.cxx/
dist/

# iOS
ios/
ios/build/
ios/Pods/
ios/.symlinks/
*.ipa
*.app
*.xcarchive


# Editor and IDE configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Expo cache
.expo/

# Custom backup directories (contains copies of projects)
BACKUPS/
DOCS/
website/
venv/
.aider*/

# Audio and compressed files
sonido.zip
*.zip
*.tar.gz

# Machine Learning models (Gemma, Whisper, ONNX)
*.gguf
!assets/all-MiniLM-L6-v2-ggml-model-q4_0.gguf
*.bin
!assets/ggml-tiny.bin
*.onnx
*.model

# Local Android properties
local.properties
android/local.properties

# Scratch/temp files
scratch/



android/app/build/
*.aab
